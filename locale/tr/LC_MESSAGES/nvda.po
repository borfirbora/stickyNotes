msgid "Unnamed Control"
msgstr "İsimsiz Kontrol"

msgid "Edit Sticky Note: {control}"
msgstr "Yapışkan Not Düzenle: {control}"

msgid "Note Content (Markdown supported):"
msgstr "Not İçeriği (Markdown desteklenir):"

msgid "&Save"
msgstr "&Kaydet"

msgid "&Cancel"
msgstr "&İptal"

msgid "&Delete Note"
msgstr "Notu &Sil"

msgid "{app} - Saved Notes ({count})"
msgstr "{app} - Kayıtlı Notlar ({count} adet)"

msgid "Press Enter on a note to focus its control, or F2 to edit it:"
msgstr "Kontrole odaklanmak için Enter tuşuna, düzenlemek için F2 tuşuna basın:"

msgid "&Focus (Enter)"
msgstr "&Odaklan (Enter)"

msgid "&Edit (F2)"
msgstr "&Düzenle (F2)"

msgid "&Browse Mode View"
msgstr "&Sanal Web Görünümü"

msgid "&Close"
msgstr "&Kapat"

msgid "Virtual Sticky Notes"
msgstr "Sanal Yapışkan Notlar"

msgid "Note saved."
msgstr "Not kaydedildi."

msgid "Note deleted."
msgstr "Not silindi."

msgid "Note: {summary}"
msgstr "Not: {summary}"

msgid "Add or edit a sticky note for the focused control."
msgstr "Odaktaki kontrole yapışkan not ekler veya mevcut notu düzenler."

msgid "Open the list of saved notes for the active application."
msgstr "Aktif uygulamadaki kayıtlı notların listesini açar."

msgid "No notes saved for {app}."
msgstr "{app} uygulaması için kayıtlı not yok."

msgid "Control Note"
msgstr "Kontrol Notu"

msgid "Sticky Note - {control}"
msgstr "Yapışkan Not - {control}"

msgid "View the sticky note of the focused control in browse mode."
msgstr "Odaktaki kontrolün yapışkan notunu sanal web arayüzünde görüntüler."

msgid "No note saved for this control."
msgstr "Bu kontrolde kayıtlı not yok."

msgid "Control for this note was not found in the active window."
msgstr "Bu nota ait kontrol aktif pencerede bulunamadı."

msgid "Could not focus the control for this note."
msgstr "Bu nota ait kontrole odaklanılamadı."

msgid "{control}. Note: {summary}"
msgstr "{control}. Not: {summary}"

msgid "Moved navigator object to {control}. Note: {summary}"
msgstr "Dolaşım nesnesi {control} öğesine taşındı. Not: {summary}"

msgid "Moved navigator object to {control}."
msgstr "Dolaşım nesnesi {control} öğesine taşındı."

msgid "Already on {control}. Note: {summary}"
msgstr "Zaten {control} üzerindesiniz. Not: {summary}"

msgid "Already on {control}."
msgstr "Zaten {control} üzerindesiniz."

msgid "No noted controls found in the active window."
msgstr "Aktif pencerede not içeren bir kontrol bulunamadı."

msgid "Focus the next control with a sticky note in the active window."
msgstr "Aktif pencerede yapışkan not bulunan sonraki kontrole odaklanır."

msgid "Focus the previous control with a sticky note in the active window."
msgstr "Aktif pencerede yapışkan not bulunan önceki kontrole odaklanır."